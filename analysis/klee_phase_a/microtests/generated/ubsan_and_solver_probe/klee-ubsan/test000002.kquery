array value[4] : w32 -> w8 = symbolic
(query [(Eq false
             (And (Eq false
                      (Slt 2147483647
                           N0:(Add w64 1
                                       (SExt w64 (ReadLSB w32 0 value)))))
                  (Eq false (Slt N0 18446744071562067968))))]
        false)
