array count[4] : w32 -> w8 = symbolic
array factor[1] : w32 -> w8 = symbolic
array value[4] : w32 -> w8 = symbolic
(query [(Slt N0:(ReadLSB w32 0 value)
              0)
         (Slt 0
              N1:(SExt w32 (Read w8 0 factor)))
         (Eq false (Eq 2147483648 N0))
         (Eq false
             (Ult 65535
                  (Add w32 (Add w32 (LShr w32 (Mul w32 N2:(ZExt w32 (Extract w16 0 (And w32 N3:(Sub w32 0 N0) 65535)))
                                                       N4:(ZExt w32 (Extract w16 0 (And w32 N1 65535))))
                                              16)
                                    (And w32 (Mul w32 N2
                                                      (ZExt w32 (Extract w16 0 (LShr w32 (And w32 N1 4294901760) 16))))
                                             65535))
                           (And w32 (Mul w32 (ZExt w32 (Extract w16 0 (LShr w32 (And w32 N3 4294901760) 16)))
                                             N4)
                                    65535))))
         (Eq false
             (And (Sle 0
                       N5:(ZExt w64 (ReadLSB w32 0 count)))
                  (Slt N5 32)))]
        false)
