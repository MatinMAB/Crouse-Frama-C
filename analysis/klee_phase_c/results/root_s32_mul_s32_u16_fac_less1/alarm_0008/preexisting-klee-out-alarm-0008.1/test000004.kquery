array count[4] : w32 -> w8 = symbolic
array factor[2] : w32 -> w8 = symbolic
array value[4] : w32 -> w8 = symbolic
(query [(Eq false
             (Slt N0:(ReadLSB w32 0 value)
                  0))
         (Slt 0 N0)
         (Eq false
             (Sle (Mul w64 (SExt w64 (ZExt w32 (Extract w16 0 (And w32 N0 65535))))
                           (SExt w64 (ZExt w32 (Extract w16 0 (And w32 (ZExt w32 (ReadLSB w16 0 factor))
                                                                       65535)))))
                  2147483647))
         (Eq false
             (Ult (ZExt w64 (ReadLSB w32 0 count))
                  32))]
        false)
