array m[2] : w32 -> w8 = symbolic
array u[1] : w32 -> w8 = symbolic
array uold[1] : w32 -> w8 = symbolic
array yold[2] : w32 -> w8 = symbolic
(query [(Sle 0
              (SExt w64 (Sub w32 (ZExt w32 (Read w8 0 u))
                                 (ZExt w32 (Read w8 0 uold)))))
         (Eq false
             (Sle 0
                  (SExt w64 (Sub w32 N0:(Mul w32 (SExt w32 (ReadLSB w16 0 yold))
                                                 (ZExt w32 (ReadLSB w16 0 m)))
                                     (Mul w32 65536 (SDiv w32 N0 65536))))))]
        false)
