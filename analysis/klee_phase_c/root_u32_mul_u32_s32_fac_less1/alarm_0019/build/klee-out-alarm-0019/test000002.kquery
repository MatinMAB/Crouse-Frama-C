array count[4] : w32 -> w8 = symbolic
array factor[4] : w32 -> w8 = symbolic
array value[4] : w32 -> w8 = symbolic
(query [(Eq false
             (Slt N0:(ReadLSB w32 0 factor)
                  0))
         (Eq false
             (Sle (Mul w64 (SExt w64 (ZExt w32 (Extract w16 0 (And w32 (ReadLSB w32 0 value)
                                                                       65535))))
                           (SExt w64 (ZExt w32 (Extract w16 0 (And w32 N0 65535)))))
                  2147483647))
         (Eq false
             (And (Sle 0
                       N1:(ZExt w64 (Add w32 4294967264
                                             (ReadLSB w32 0 count))))
                  (Slt N1 32)))]
        false)
