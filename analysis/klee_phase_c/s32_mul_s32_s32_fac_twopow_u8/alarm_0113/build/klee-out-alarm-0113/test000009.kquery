array factor[4] : w32 -> w8 = symbolic
array power[1] : w32 -> w8 = symbolic
array value[4] : w32 -> w8 = symbolic
(query [(Sle 32
              (ZExt w32 (Read w8 0 power)))
         (Slt N0:(ReadLSB w32 0 value)
              0)
         (Slt 0
              N1:(ReadLSB w32 0 factor))
         (Eq false (Eq 2147483648 N0))
         (Eq false
             (Sle (Mul w64 (SExt w64 (ZExt w32 (Extract w16 0 (And w32 (Sub w32 0 N0) 65535))))
                           (SExt w64 (ZExt w32 (Extract w16 0 (And w32 N1 65535)))))
                  2147483647))]
        false)
